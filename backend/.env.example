# Get a free Groq key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

GROQ_MODEL=openai/gpt-oss-20b

# Get a free Tavily key at: https://app.tavily.com/home
TAVILY_API_KEY=your_tavily_api_key_here

# Guardrails: cheap model for the ingress LLM safety check (stage 5)
GUARD_MODEL=openai/gpt-oss-20b
# Reasoning effort for the guard (gpt-oss models); leave empty for a non-reasoning model
GUARD_REASONING_EFFORT=low
GUARD_LLM_ENABLED=true
# Guard call budget: seconds per attempt and retries; on failure the check is skipped
GUARD_TIMEOUT_S=8
GUARD_MAX_RETRIES=1

# Cloudflare Workers AI for Clef (optional); token and account ID: dashboard > AI > Workers AI > Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Clef call budget: seconds for the whole check, no retries
CLEF_TIMEOUT_S=3
# Who runs the guard: groq (default), shadow (Groq decides, Clef only logged) or clef (Clef decides)
GUARD_BACKEND=groq
# Clef guard model: clef or clef-flash
CLEF_GUARD_MODEL=clef
# Clef guard rule (choice or noul) and the probability that blocks a message
# (0.4 was tuned for question set guard-v1 under choice; re-tune after any change to the questions)
CLEF_GUARD_RULE=choice
CLEF_BLOCK_THRESHOLD=0.4
# 0 = every message is one window (Clef reads 10,000 characters in full); set e.g. 6000 to
# check long messages as their first and last that many characters instead
CLEF_WINDOW_CHARS=0
# If Clef fails: groq (Groq guard, this many seconds, no retries) or open (skip the check)
CLEF_FALLBACK=groq
CLEF_FALLBACK_TIMEOUT_S=5
# Clef guard decision log (SQLite under backend/; never message text)
GUARD_LOG_DB=data/guard.db
# Shadow mode, dev only: keep the text of messages Clef and Groq disagree on, for this many days
GUARD_SHADOW_STORE_TEXT=false
GUARD_SHADOW_RETENTION_DAYS=14

# Outbound email (optional; lets Ava send an email after you approve it).
# Port 587 + STARTTLS only. For Gmail, use an App Password, not your login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=you@example.com

# Token metering: key for GET /api/admin/usage (report is disabled while empty)
ADMIN_API_KEY=
# Require an X-Client-Key header to start a chat (default false = "default" client)
REQUIRE_CLIENT_KEY=false
